{
  "name": "guestway-public-mcp",
  "version": "1.0.0",
  "description": "Public MCP server exposing Guestway's marketing surface (solutions, FAQs, integrations, industries, company info) to AI agents.",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "build": "tsc --noEmit",
