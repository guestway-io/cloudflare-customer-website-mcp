    "agents": "^0.2.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.19.19",
    "typescript": "^5.5.3",
    "vitest": "~3.0.0",
    "wrangler": "^4.0.0"
  }
