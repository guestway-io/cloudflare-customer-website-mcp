{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "guestway-public-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2025-05-01",
  "compatibility_flags": ["nodejs_compat"],
  // One canonical endpoint only: the custom domain public-mcp.guestway.io.
  // Pinned to false so deploys don't re-enable the *.workers.dev URL or the
  // per-version preview URLs (dashboard toggles lose to the config on deploy).
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true
  },
  // Brand icons for MCP clients (SEP-973). Served from the same origin as /mcp.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  // McpAgent persists each MCP session in a Durable Object. SQLite-backed
  // classes are required for the agents framework's session store.
  "durable_objects": {
    "bindings": [
      {
        "name": "MCP_OBJECT",
        "class_name": "GuestwayMCP"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["GuestwayMCP"]
    }
  ],
  "vars": {
    // Source of truth for all marketing data. The Worker fetches the
    // /data/*.json feeds + llms.txt from here at request time and caches
    // them at the edge, so a site deploy propagates without a Worker deploy.
    "SITE_URL": "https://guestway.io",
    // Customer Academy (GitBook). Its /llms.txt is a markdown index of every
    // doc page; search_docs fetches and ranks it for how-to questions.
    "DOCS_URL": "https://docs.guestway.io"
  },
  // Custom domain is attached in the Cloudflare dashboard (Workers > Domains)
  // or via `routes` once the zone is confirmed:
  // "routes": [
  //   { "pattern": "public-mcp.guestway.io", "custom_domain": true }
  // ]
}
